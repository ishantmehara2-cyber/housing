# ==================================================
# SERVER ENVIRONMENT CONFIGURATION
# ==================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==================================================
# DATABASE CONFIGURATION (MySQL Local)
# ==================================================
# Replace YOUR_PASSWORD with your actual local MySQL root password
DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/housing_clone

# ==================================================
# AUTHENTICATION & SECRETS
# ==================================================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long
SESSION_SECRET=your_session_secret_key_change_in_production

# ==================================================
# OBJECT STORAGE (S3 / MinIO)
# ==================================================
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=housing-media

# ==================================================
# MAP SERVICES
# ==================================================
MAP_PROVIDER=leaflet
MAPBOX_API_KEY=
GOOGLE_MAPS_API_KEY=

# ==================================================
# NOTIFICATIONS (Email / SMS)
# ==================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@housingclone.local

SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==================================================
# PAYMENTS (Razorpay / Stripe Interface)
# ==================================================
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
