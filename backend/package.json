{
  "name": "@housing-clone/backend",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
